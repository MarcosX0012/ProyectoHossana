# ─────────────────────────────────────────────────────────────
# HOSSANA · Variables de entorno
# Copia este archivo a .env y completa los valores.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Base de datos ───────────────────────────────────────────
# Cluster local de desarrollo (puerto 5433, ver scripts/db.ps1)
DATABASE_URL="postgresql://hossana:hossana@127.0.0.1:5433/hossana_dev?schema=public"
# Base separada para pruebas
TEST_DATABASE_URL="postgresql://hossana:hossana@127.0.0.1:5433/hossana_test?schema=public"
# PostgreSQL del sistema (opcional, si prefieres usar el existente)
# DATABASE_URL="postgresql://usuario:password@localhost:5432/hossana_dev?schema=public"

# ── Seguridad ───────────────────────────────────────────────
# OBLIGATORIO en produccion: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-bytes-minimo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# OBLIGATORIO en produccion: openssl rand -base64 32
# Cifra en reposo los datos personales (direcciones, telefonos)
PII_ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64
# Secreto para firmar las URLs publicas de rastreo (QR)
TRACKING_SIGNING_SECRET=cambia-esto-por-un-secreto-distinto

# ── Frontend / URLs publicas ────────────────────────────────
PUBLIC_WEB_URL=http://localhost:5173

# ── Courier ─────────────────────────────────────────────────
# shippingdo | guaume | starken | manual | mock
COURIER_PROVIDER=mock
SHIPPINGDO_API_TOKEN=
SHIPPINGDO_BASE_URL=https://api.shippingdo.com
SHIPPINGDO_WEBHOOK_SECRET=

# ── Pagos (Stripe) ──────────────────────────────────────────
PAYMENTS_ENABLED=false
# Transferencias manuales: tipo de cambio fijo NIO por USD.
USD_EXCHANGE_RATE_NIO=36.5
PAYMENT_PROOF_DIR=uploads/payment-proofs
PAYMENT_PROOF_MAX_MB=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Correo saliente (OTP y avisos de envios) ────────────────
# log = escribe el mensaje en el log | smtp = Gmail/SMTP | api = POST JSON
# Se usa para el OTP de registro y para las notificaciones de envios y
# asignaciones a repartidores.
# Con EMAIL_ENABLED=false los correos solo se registran en el log y el
# codigo se devuelve en la respuesta (devCode), util para desarrollo.
EMAIL_ENABLED=false
EMAIL_PROVIDER=log
# Gmail reescribe el remitente: debe ser la misma cuenta de EMAIL_SMTP_USER
EMAIL_FROM=Hossana <no-reply@hossana.local>
# Para Gmail: activa la verificacion en 2 pasos y genera una contrasena
# de aplicacion (myaccount.google.com/apppasswords). Son 16 caracteres,
# se pegan SIN espacios. La contrasena normal de la cuenta no sirve.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Solo se usan cuando EMAIL_PROVIDER=api
EMAIL_API_URL=
EMAIL_API_KEY=

# ── Credenciales de servicio ────────────────────────────────
# Tokens para CI, jobs y webhooks que no son usuarios.
# Formato por entrada: "<audience>:<secreto>"
# Audiences validos: webhook | internal | integration
SERVICE_API_KEYS=dev-webhook-secret-cambia-en-produccion-000,dev-internal-secret-cambia-en-produccion-0